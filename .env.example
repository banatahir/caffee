# Copy to .env and fill in. Never commit .env.
PORT=3000
CAFE_NAME=کافێی ئێمە
SITE_URL=https://www.example.com
TIMEZONE=Asia/Baghdad
OPEN_TIME=08:00
CLOSE_TIME=16:00

# ئیمەیڵی خاوەن — حیجز و داواکاری و نامەکان لێرە دەگەن
OWNER_EMAIL=you@example.com

# SMTP (Gmail: smtp.gmail.com, 587, App Password). بەتاڵ = ئیمەیڵ لە console چاپ دەکرێت
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="کافێی ئێمە" <you@example.com>

# ئاگادارکردنەوەی دەستبەجێ لە تێلێگرام (ئارەزووی)
# 1) لە @BotFather بۆتێک دروست بکە و token وەربگرە  2) نامەیەک بنێرە بە بۆتەکە، پاشان chat_id لە
#    https://api.telegram.org/bot<TOKEN>/getUpdates وەربگرە
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# تەنها ئەگەر ماڵپەڕ لە دۆمەینێکی تر دانرا (کۆما بۆ جیاکردنەوە)
ALLOWED_ORIGIN=

# ڕای زیندووی Google (Places API New). بەتاڵ = بەشەکە شاراوەیە
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=
